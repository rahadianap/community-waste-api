    {
      "name": "1. Households",
      "item": [
        {
          "name": "Create Household",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.environment.set('household_id', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner_name\": \"Budi Santoso\",\n  \"address\": \"Jl. Merdeka No. 10, RT 01/RW 02\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/households",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "households"
              ]
            }
          }
        },
        {
          "name": "List Households",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/households?limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "households"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Household Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/households/{{household_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
