    {
      "name": "3. Payments",
      "item": [
        {
          "name": "Create Manual Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.environment.set('payment_id', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"household_id\": \"{{household_id}}\",\n  \"waste_id\": \"{{pickup_id}}\",\n  \"amount\": 50000\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/payments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "payments"
              ]
            }
          }
        },
        {
          "name": "List Payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/payments?status=pending&start_date=2026-10-01&end_date=2026-10-31&limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "payments"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                },
                {
                  "key": "start_date",
                  "value": "2026-10-01"
                },
                {
                  "key": "end_date",
                  "value": "2026-10-31"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Confirm Payment with Proof",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "proof_file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/payments/{{payment_id}}/confirm",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "payments",
                "{{payment_id}}",
                "confirm"
              ]
            }
          }
        }
      ]
